# Graph API Explorer'dan alınan kısa ömürlü token'ı uzun ömürlüye çevirip buraya yaz.
# Uzun ömürlü token ~60 gün geçerli; süresi dolunca yenile.
FB_TOKEN=
# İsteğe bağlı: farklı bir Graph API sürümü kullanmak için
# FB_GRAPH_VERSION=v23.0

# Token ömrünü uzatmak için gerekli (developers.facebook.com > uygulaman >
# Ayarlar > Temel). token.py bunları kullanır.
FB_APP_ID=
FB_APP_SECRET=
